# Required: admin panel credentials
ADMIN_USER=admin
ADMIN_PASS=change-me

# Recommended: long random string used to sign sessions
# SESSION_SECRET=

# Optional: storage quota in GB (default 4.5)
# QUOTA_GB=4.5

# Optional: where files and db.json live (default ./data)
# DATA_DIR=/home/USER/uploader-data

# Optional: number of reverse-proxy hops to trust for client IPs (default 1; 0 = none)
# TRUST_PROXY=1
